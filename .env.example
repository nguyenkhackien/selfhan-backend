NODE_ENV=development
PORT=3000
# Native local development uses localhost. Docker Compose overrides the hostname to db.
DATABASE_URL=postgres://selfhan:change-me@localhost:5432/selfhan
# Generate a unique value, for example: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-random-32-byte-minimum-secret
JWT_ACCESS_EXPIRATION=15m
FRONTEND_ORIGIN=http://localhost:5173

# Used by compose.yaml. Do not reuse these placeholder values.
POSTGRES_DB=selfhan
POSTGRES_USER=selfhan
POSTGRES_PASSWORD=change-me
